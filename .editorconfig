# .editorconfig
# https://editorconfig.org
#
# Aligns editor behaviour with docs/documentation-guide.md and
# .markdownlint.yaml.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown uses 2-space indent for nested lists
indent_size = 2

[*.{go,mod,sum}]
# Go uses tabs (handled by gofmt)
indent_style = tab
indent_size = 4

[*.{yml,yaml,json,jsonc}]
indent_size = 2

[Makefile]
indent_style = tab