{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thapelomagqazana/forge/schemas/dependency-matrix.schema.json",
  "title": "Forge Dependency Matrix",
  "description": "Schema for docs/architecture/dependency-matrix.yaml. See ADR-042.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "schema", "adr", "groups", "matrix", "conditions", "exceptions"],
  "properties": {
    "version": { "const": 1 },
    "schema": { "type": "string" },
    "adr": { "type": "string" },
    "traceability": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "groups": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "packages"],
        "properties": {
          "layer": {
            "enum": ["presentation", "application", "domain", "infrastructure", "shared"]
          },
          "packages": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^internal(/[a-z0-9_]+)+$" },
            "uniqueItems": true
          }
        }
      }
    },
    "matrix": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "pattern": "^(allow|deny|condition:[A-Z][0-9]+)$"
        }
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "rationale", "applies_to", "enforced_by"],
        "properties": {
          "summary": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "applies_to": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.]+ -> [a-z][a-z0-9.]+$"
            }
          },
          "enforced_by": { "enum": ["layer", "review", "type-checker"] }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group", "applies_to", "rationale"],
        "properties": {
          "group": { "type": "string", "minLength": 1 },
          "applies_to": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}