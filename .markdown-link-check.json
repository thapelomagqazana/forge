{
  "ignorePatterns": [
    {
      "pattern": "^https://github.com/thapelomagqazana/forge/(issues|pulls|releases)"
    },
    {
      "pattern": "^https://github.com/thapelomagqazana/forge/blob/main/"
    }
  ],
  "replacementPatterns": [
    {
      "pattern": "^/",
      "replacement": "{{BASEURL}}/"
    }
  ],
  "httpHeaders": [
    {
      "urls": ["https://github.com", "https://golang.org", "https://go.dev"],
      "headers": {
        "Accept": "text/html"
      }
    }
  ],
  "timeout": "20s",
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [200, 206, 301, 302, 307, 308, 403, 429]
}