# =============================================================================
# docs/env.example — environment template for contributors
# =============================================================================
#
# This file documents the environment variables that affect how the
# Go toolchain resolves modules. It is a template, not a
# configuration: nothing reads it automatically.
#
# # How to use it
#
# If you are behind a restrictive network or an internal proxy, copy
# the relevant lines into your shell profile (~/.bashrc, ~/.zshrc,
# or ~/.config/fish/config.fish). Do not commit the modified file.
#
# # Why it is a separate file
#
# The decisions documented here are the *default* decisions for
# Forge. They are correct for most contributors. The template exists
# for the minority of contributors whose network environment
# requires overrides.
#
# See docs/dependency-policy.md, section "Module resolution policy",
# for the rationale behind each decision.
#
# =============================================================================

# ─────────────────────────────────────────────────────────────────────
# Required variables
# ─────────────────────────────────────────────────────────────────────
#
# These variables must be set in every environment, including
# developer machines and CI runners. If they are not set, the
# pre-commit hook and CI fail.
#
# The values below are the canonical values. Do not override them.

# GOFLAGS prevents silent mutation of go.mod. Set it in every
# environment. See ADR-005 for the rationale.
export GOFLAGS=-mod=readonly

# GOTOOLCHAIN allows Go to select the toolchain pinned by go.mod.
# Set it to "auto" in every environment. Use "local" only in
# air-gapped environments where the toolchain cannot be downloaded.
export GOTOOLCHAIN=auto

# ─────────────────────────────────────────────────────────────────────
# Optional variables — default values
# ─────────────────────────────────────────────────────────────────────
#
# These variables have correct defaults. Do not set them unless your
# environment requires an override.

# GOPROXY is the module download source. The default is the public
# Go proxy, which is highly available and provides integrity
# guarantees via the checksum database.
#
# Override only if your network cannot reach the public proxy.
# Examples:
#
#   # Behind an internal proxy
#   export GOPROXY=https://your-proxy.internal,direct
#
#   # Direct git access (slow, no proxy caching)
#   export GOPROXY=direct
#
#   # Offline (uses only the local cache)
#   export GOPROXY=off
#
# When overriding, use the ",direct" suffix. Without it, the
# toolchain cannot fall back to direct git access if the proxy
# fails to serve a module.
#
# export GOPROXY=https://proxy.golang.org,direct

# GOSUMDB is the checksum database. It verifies that every module
# matches its published checksum.
#
# DO NOT override this variable. Disabling checksum verification
# breaks the integrity guarantee and makes builds non-reproducible.
#
# The only legitimate override is for private modules, which are
# excluded via GOPRIVATE. Forge has no private modules in Phase 2.
#
# export GOSUMDB=sum.golang.org

# GOPRIVATE tells the toolchain which module paths are private.
# For private paths, the toolchain bypasses the proxy and the
# checksum database.
#
# Forge has no private modules in Phase 2. Leave this empty.
#
# export GOPRIVATE=

# GONOSUMDB is an alternative to GOPRIVATE. It lists module paths
# for which the checksum database is not consulted.
#
# Forge has no such paths in Phase 2. Leave this empty.
#
# export GONOSUMDB=

# GOMODCACHE is the module cache directory. The default is
# $GOPATH/pkg/mod.
#
# Override only if your environment requires isolation — for
# example, a CI runner that should not reuse the cache from
# previous jobs.
#
# export GOMODCACHE=$HOME/.cache/go-mod

# ─────────────────────────────────────────────────────────────────────
# Prohibited variables
# ─────────────────────────────────────────────────────────────────────
#
# The following variables must never be set. Setting them breaks
# the reproducibility invariant or the integrity guarantee.
#
#   GONOSUMCHECK
#     Deprecated. Replaced by GONOSUMDB.
#
#   GO111MODULE
#     Deprecated. Go 1.16 and later always use modules.
#
#   GOFLAGS=-mod=mod
#     Allows silent mutation of go.mod. Directly contradicts the
#     policy.
#
#   GOINSECURE
#     Bypasses TLS for module downloads. Never acceptable.
#
# If you see these variables in your environment, unset them:
#
#   unset GONOSUMCHECK GO111MODULE GOINSECURE

# ─────────────────────────────────────────────────────────────────────
# Verifying your environment
# ─────────────────────────────────────────────────────────────────────
#
# After setting up your environment, run:
#
#   task verify:deps:env-policy
#
# The check verifies that your environment conforms to the policy.
# If it reports a violation, the failure message identifies which
# variable is misconfigured and how to fix it.