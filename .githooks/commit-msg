#!/usr/bin/env sh
# =============================================================================
# .githooks/commit-msg — validate the commit message format
# =============================================================================
#
# This hook runs after `git commit` has assembled the commit message
# but before the commit is finalised. It validates the message against
# the Conventional Commits format used by Forge.
#
# Format:
#
#   <type>(<scope>): <subject>
#
#   <body>
#
#   <footer>
#
# Where:
#
#   <type>     is one of: feat, fix, docs, style, refactor, perf,
#              test, build, ci, chore, revert.
#
#   <scope>    is optional. When present, it names the affected
#              component, e.g. cli, config, deps, hooks, module.
#
#   <subject>  is a lowercase imperative phrase without trailing period.
#
#   <body>     is optional. Wrapped at 72 columns.
#
#   <footer>   is optional. Contains Refs, Fixes, Co-authored-by, etc.
#
# The hook also enforces:
#
#   - The subject line is at most 72 characters.
#   - The subject line does not end with a period.
#   - The subject line starts with a lowercase letter.
#
# Merge commits and revert commits are exempted from the type check
# (their messages are generated by Git).
#
# To bypass this hook for a single commit:
#
#   git commit --no-verify
#
# Bypassing is discouraged. Fix the message instead.
# =============================================================================

set -eu

# ─────────────────────────────────────────────────────────────────────────────
# Setup
# ─────────────────────────────────────────────────────────────────────────────
#
# The commit message is passed as a path to a file containing the
# message. Read the first non-empty, non-comment line as the subject.
#
msg_file="$1"

if [ ! -f "$msg_file" ]; then
    echo "commit-msg hook: message file not found: $msg_file" >&2
    exit 1
fi

# Read the first non-empty line that is not a comment.
subject=""
while IFS= read -r line; do
    case "$line" in
        ""|\#*) continue ;;
        *) subject="$line"; break ;;
    esac
done < "$msg_file"

if [ -z "$subject" ]; then
    echo "commit-msg hook: empty commit message" >&2
    exit 1
fi

# ─────────────────────────────────────────────────────────────────────────────
# Exemptions
# ─────────────────────────────────────────────────────────────────────────────
#
# Merge commits and revert commits have messages generated by Git and
# are exempt from the format check.
#
case "$subject" in
    "Merge "*|"Revert "*)
        exit 0
        ;;
esac

# ─────────────────────────────────────────────────────────────────────────────
# Validation
# ─────────────────────────────────────────────────────────────────────────────

fail() {
    echo "" >&2
    echo "commit-msg hook: $1" >&2
    echo "" >&2
    echo "Subject: $subject" >&2
    echo "" >&2
    echo "Format:  <type>(<scope>): <subject>" >&2
    echo "" >&2
    echo "Types:   feat, fix, docs, style, refactor, perf, test," >&2
    echo "         build, ci, chore, revert" >&2
    echo "" >&2
    echo "Example: feat(cli): add config command" >&2
    echo "" >&2
    exit 1
}

# Subject length.
if [ "${#subject}" -gt 72 ]; then
    fail "subject line exceeds 72 characters (${#subject})"
fi

# Subject must not end with a period.
case "$subject" in
    *.) fail "subject line must not end with a period" ;;
esac

# Subject must match the Conventional Commits pattern.
#
# The pattern accepts:
#
#   <type>: <subject>
#   <type>(<scope>): <subject>
#   <type>!: <subject>              (breaking change marker)
#   <type>(<scope>)!: <subject>
#
# The scope, when present, must be lowercase letters, digits, or hyphens.
#
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: [a-z].+$'

if ! printf '%s' "$subject" | grep -qE "$pattern"; then
    fail "subject does not match Conventional Commits format"
fi

exit 0